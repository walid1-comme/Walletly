# Your deployed Cloudflare Worker
VITE_API_URL=https://manifest-api.your-subdomain.workers.dev

# Supabase project (Settings, API). The anon key is public by design.
# Leave both blank to run without accounts.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Stripe payment links (optional until you take real payments)
VITE_PAY_MONTHLY=
VITE_PAY_QUARTERLY=
